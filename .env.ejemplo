# Copie este archivo como .env y ajuste los valores a su instalación local.

# Clave secreta de Django. Genere una nueva con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambie-esta-clave

# True para desarrollo local; False para un servidor compartido.
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Conexión a MySQL 8.0 o superior
DB_NAME=libra_nomina
DB_USER=libra
DB_PASSWORD=libra2026
DB_HOST=127.0.0.1
DB_PORT=3306
